// Arena geometry for MAP_ID=2 (Scenario::StressTest — MapKind::Arena).
// Ported from the hardcoded consts in crates/shared/src/arena.rs
// (ARENA_HALF_SIZE / ARENA_WALL_* / NAVMESH_COLUMN_OBSTACLES / arena_ramp()).
//
// Each row is ONE static piece:
//   (shape, size_x, size_y, size_z, x, y, z, rot_x_deg, rot_y_deg, rot_z_deg)
// shape = Cuboid | Cylinder. Cuboid uses all three sizes as full extents.
// Cylinder uses size_x as its full DIAMETER and size_y as its height
// (size_z is ignored — kept equal to size_x here for tidiness).
// translation in meters; rotation as X/Y/Z euler degrees (EulerRot::YXZ,
// same as item_gallery_car_physics.ron).
//
// Row 0 is the floor by convention (client paints it with the floor
// material); every other row uses the wall material.
//
// Both the server (spawn_flat_arena_colliders, collider only) and the
// client (spawn_test_arena, mesh + collider) iterate this list, so their
// physics can't drift. Read once per process via a CARGO_MANIFEST_DIR
// relative path, cached per map id (shared::arena_layout).
//
// Tune by dragging / rotating a piece in the dev editor (F2); with
// EDITOR=1 on this map, F9 writes every ArenaBox's live Transform back
// here (save_arena_layout_on_key in crates/client/src/arena_layout.rs).
// The server's zombie navmesh is auto-generated from the Cylinder rows'
// colliders (NavmeshUpdaterPlugin) — moving a pillar just needs a server
// restart, no hand-kept obstacle list.
[
    (Cuboid, 72.0, 1.0, 72.0, 0.0, -0.5, 0.0, 0.0, 0.0, 0.0),               // floor
    (Cuboid, 73.0, 5.0, 1.0, 0.0, 2.5, -36.0, 0.0, 0.0, 0.0),               // wall N
    (Cuboid, 73.0, 5.0, 1.0, 0.0, 2.5, 36.0, 0.0, 0.0, 0.0),                // wall S
    (Cuboid, 1.0, 5.0, 73.0, -36.0, 2.5, 0.0, 0.0, 0.0, 0.0),               // wall W
    (Cuboid, 1.0, 5.0, 73.0, 36.0, 2.5, 0.0, 0.0, 0.0, 0.0),                // wall E
    (Cylinder, 1.2, 5.0, 1.2, -8.0, 2.5, -6.0, 0.0, 0.0, 0.0),              // pillar
    (Cylinder, 1.2, 5.0, 1.2, 8.0, 2.5, -6.0, 0.0, 0.0, 0.0),               // pillar
    (Cylinder, 1.2, 5.0, 1.2, -8.0, 2.5, 6.0, 0.0, 0.0, 0.0),               // pillar
    (Cylinder, 1.2, 5.0, 1.2, 8.0, 2.5, 6.0, 0.0, 0.0, 0.0),                // pillar
    (Cylinder, 1.2, 5.0, 1.2, -4.0, 2.5, 0.0, 0.0, 0.0, 0.0),               // pillar
    (Cylinder, 1.2, 5.0, 1.2, 4.0, 2.5, 0.0, 0.0, 0.0, 0.0),                // pillar
    (Cylinder, 1.2, 5.0, 1.2, 0.0, 2.5, -10.0, 0.0, 0.0, 0.0),              // pillar
    (Cylinder, 1.2, 5.0, 1.2, 0.0, 2.5, 10.0, 0.0, 0.0, 0.0),               // pillar
    (Cuboid, 4.0, 1.0, 6.7082, 0.0, 1.0528, 5.2236, -26.5651, 0.0, 0.0),    // ramp
]
