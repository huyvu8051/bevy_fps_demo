// Shipped defaults for iOS/Android — see default_settings_desktop.ron's
// own doc comment for the overall file/load/reset flow, which applies
// here identically. Only the values that actually differ from desktop
// (mobile's tighter perf headroom: lower texture/poly/shadow tiers) are
// pinned to something different; everything else matches desktop's file
// value-for-value.
(
    light_quality: None,
    shadow_quality: Some(1),
    point_light_quality: None,
    render_resolution_scale: None,
    fps_cap: None,
    map_msaa_on: Some(false),
    scope_camera_enabled: Some(true),
    sensitivity_scale: Some(1.0),
    damage_multiplier: Some(1.0),
    noclip: Some(false),
    god_mode: Some(false),
    freeze_zombies: Some(false),
    show_hitboxes: Some(false),
    aim_blur_enabled: Some(true),
    zombie_anim_disabled: Some(false),
    zombie_health_bars_hidden: Some(false),
    gun_visible: Some(true),
    cars_visible: Some(true),
    aim_dof_focal_distance_alt: Some(false),
    autopilot_look_only: Some(false),
    show_autopilot_target: Some(false),
    show_hit_markers: Some(true),
    show_floating_damage: Some(true),
    show_bullet_tracers: Some(true),
    autopilot: None,
    nav_debug_visible: Some(false),
)
