// Per-car entity Transform placement:
//   (scale, y, x, z, rot_x_deg, rot_y_deg, rot_z_deg)
// uniform scale, translation in meters, rotation as X/Y/Z euler degrees
// (applied EulerRot::YXZ). Same order/count as shared::ARENA_CAR_PATHS
// (index i here is car i there).
//
// That's all this file drives now: the car collider is built from the real
// glTF mesh (ColliderConstructor::ConvexHullFromMesh, client + server), so
// there's no width/height/depth here.
//
// All 16 re-exported (2026-09-05) via Meshy's "Resize + Origin: Bottom"
// download option, each Height set from docs/maps/gdd/map01_dimensions.md
// section 1's item library — confirmed by inspecting each new `_light.glb`'s
// own POSITION accessor bbox: real-world height matches the docs table
// exactly and min_y = 0.000 for every one. So every car now sits at
// scale 1.0 / y 0.0 — no more per-car scale/Y correction hacks. x/z started
// as a computed 2×8 grid (start_x -21, 6m spacing, rows at z -6 / -14) —
// now just seed values you can nudge.
//
// Tune by eyeballing each car in the dev editor (F2) and dragging /
// rotating / scaling it; with EDITOR=1, F9 writes
// every car's live scale + x/y/z + rotation back here
// (save_arena_car_physics_on_key in
// crates/client/src/arena_cars.rs). Hand-editing works fine too.
[
    (1.0, 0.0, -21.0008, -5.9952, -0.0, 0.2021, -0.0001),       // sedan
    (1.0, 0.0, -15.1528, -5.9934, -0.0, -1.8896, -0.0015),   // van
    (1.0, 0.0, -9.3002, -1.8, 0.0, -27.3101, -0.0008),         // pickup
    (1.0, 0.0, -3.0, -6.0, -0.0, 0.0017, -0.0),              // vf3
    (1.0, 0.0, 3.0043, -6.0004, 0.0, -0.1802, -0.0006),        // suv
    (1.0, 0.0, 9.4583, -5.9018, -0.0021, -4.1041, -0.0352),    // hatchback
    (1.0, 0.0, 16.0958, -8.4924, -0.0, 0.3119, -0.0),          // sports
    (1.0, 0.0, 21.0, -6.0, -0.0, 0.0, -0.0),                   // taxi
    (1.0, 0.0, -21.0018, -14.0061, -0.0003, -0.0992, -0.0003), // police
    (1.0, 0.0, -14.9994, -13.9993, -0.0, 0.0292, -0.0),          // ambulance
    (1.0, 0.0, -8.9997, -13.9989, -0.0, -0.0102, -0.0),          // delivery
    (1.0, 0.0, -3.0029, -14.0089, 0.0, 0.2432, -0.0),           // towtruck
    (1.0, 0.0, 3.0, -14.0, 0.0, 0.0, -0.0),                    // wagon
    (1.0, 0.0, 9.0, -14.0, -0.0, 0.0001, -0.0),                // motorcycle
    (1.0, 0.0, 15.0, -14.0, -0.0, -0.0, -0.0),                 // muscle
    (1.0, 0.0, 21.0015, -13.9969, -0.0, 0.154, -0.0),          // minivan
]
