// Per-car entity Transform placement:
//   (scale, y, x, z, rot_x_deg, rot_y_deg, rot_z_deg)
// uniform scale, translation in meters, rotation as X/Y/Z euler degrees
// (applied EulerRot::YXZ). Same order/count as shared::ITEM_GALLERY_CAR_PATHS
// (index i here is car i there).
//
// That's all this file drives now: the car collider is built from the real
// glTF mesh (ColliderConstructor::ConvexHullFromMesh, client + server), so
// there's no width/height/depth here.
//
// van / vf3 keep a big `scale` (and the first 4 cars a Y offset) because
// they were exported before Meshy's "Resize + Origin: Bottom" option; the
// rest sit at scale 1.0. x/z started as a computed 2×8 grid (start_x -21,
// 6m spacing, rows at z -6 / -14) — now just seed values you can nudge.
//
// Tune by eyeballing each car in the dev editor (F2) and dragging /
// rotating / scaling it; with EDITOR=1 in Scenario::ItemGallery, F9 writes
// every car's live scale + x/y/z + rotation back here
// (save_item_gallery_car_physics_on_key in
// crates/client/src/item_gallery_cars.rs). Hand-editing works fine too.
[
    (2.2, 1.0064, -21.0, -6.0, -0.0, 0.0001, -0.0),  // sedan
    (115.0, 0.3495, -15.0, -6.0, -0.0, -0.0, -0.0),  // van
    (1.0, 0.3471, -9.0, -6.0, 0.0, -0.0001, -0.0),   // pickup
    (100.0, 0.3486, -3.0, -6.0, -0.0, 0.0019, -0.0), // vf3
    (1.0, 0.3493, 3.0, -6.0, -0.0, 0.0001, -0.0),    // suv
    (1.0, 0.3456, 9.0, -6.0, 0.0, -0.0, -0.0),       // hatchback
    (1.0, 0.3452, 16.1, -8.5, 0.0, 0.0001, -0.0),    // sports
    (1.0, 0.3493, 21.0, -6.0, -0.0, 0.0, -0.0),      // taxi
    (1.0, 0.3453, -21.0, -14.0, 0.0, -0.0001, -0.0), // police
    (1.0, 0.35, -15.0, -14.0, 0.0, 0.0, -0.0),       // ambulance
    (1.0, 0.3485, -9.0, -14.0, 0.0, 0.0, -0.0),      // delivery
    (1.0, 0.348, -3.0, -14.0, 0.0, 0.0, 0.0),        // towtruck
    (1.0, 0.3455, 3.0, -14.0, 0.0, 0.0, -0.0),       // wagon
    (1.0, 0.3497, 9.0, -14.0, -0.0, 0.0001, -0.0),   // motorcycle
    (1.0, 0.3448, 15.0, -14.0, 0.0, -0.0, -0.0),     // muscle
    (1.0, 0.3492, 21.0, -14.0, -0.0, -0.0, 0.0),     // minivan
]
