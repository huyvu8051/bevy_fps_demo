// Metadata for the "soldier_meshy" character — a Meshy AI-generated
// survivor mesh (see docs/PLAYER_ANIMATION_PLAN.md's Meshy prompt), added
// as an alternative to the shipped "soldier" (crates/client/src/lib.rs's
// PLAYER_MODEL_PATH) — NOT yet wired in as the active player model.
//
// Original Meshy export was two ~55MB glb files (a 8192x8192 PNG texture
// each) — compressed to this one file (texture resized to 2048x2048 JPEG,
// ~1.6MB total) by patching the glb's embedded image buffer directly
// (chat history has the exact script). Bundles both the mesh AND all 16
// generated animation clips.
//
// scale/y_offset/facing_deg below are UNMEASURED placeholders (0.0/1.0/0)
// — use the "Player Animations" editor window (EDITOR=1, F2, Window ->
// Open window -> Player Animations) to pick this file from its mesh
// dropdown and tune them for real, same F9-save workflow as `soldier`'s
// own character.ron.
(
    id: "soldier_meshy",
    display_name: "Soldier (Meshy)",
    lore_ref: "docs/characters/soldier.md",

    mesh: "characters/soldier_meshy/mesh/soldier_meshy.glb",
    scale: 1.0,
    y_offset: 0.0,
    facing_deg: 0.0,

    // None of these are confirmed — this rig's clips came out with messy
    // auto-generated names (hash IDs, "Walk_Backward_with_Bow_1_inplace",
    // etc.) and NO dedicated Idle or Death clip at all. Placeholder indices
    // (0 for everything) until picked for real in the editor window's
    // clip-name list.
    animations: (
        idle: 0,
        walk: 0,
        run: 0,
        shoot: 0,
        death: 0,
    ),

    audio: [],
)
