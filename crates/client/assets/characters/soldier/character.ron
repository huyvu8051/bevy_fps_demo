// Metadata for the "soldier" character (PLAYER_MODEL_PATH in
// crates/client/src/lib.rs) — the visual model for every human player
// (local player's optional debug model + every remote NetPlayer).
//
// THE single source of truth for this character's scale/offset/facing AND
// animation clip-index mapping — both loaded for real at runtime (see
// PlayerModelTuning, crates/client/src/lib.rs), not just documentation.
// `scale`/`y_offset`/`facing_deg` are also F9-tunable (EDITOR=1): look at
// the local player in third-person (KeyU), nudge with Comma/Period (scale)
// and Minus/Equal (y_offset), then F9 rewrites this whole file — see
// nudge_player_model_tuning/save_player_model_tuning
// (crates/client/src/movement_combat.rs). `animations` isn't nudge-able
// (there's no live control for it), only hand-edited.
(
    id: "soldier",
    display_name: "Soldier",
    lore_ref: "docs/characters/soldier.md",

    mesh: "characters/soldier/mesh/soldier.glb",
    // See docs/CHARACTER_IMPORT_CHECKLIST.md before replacing this mesh.
    // This rig's root sits near the hips, not the feet (unlike the
    // zombie's) — y_offset carries the extra hip-to-ground drop, see
    // PlayerModelTuning's own doc comment.
    scale: 0.85,
    y_offset: -1.3,
    // Y-axis yaw correction — this asset's rig faces +Z, not Bevy's
    // -Z-forward convention.
    facing_deg: 180.0,

    // soldier.glb ships a large multi-animation pack (indices aren't
    // sequential — this asset was picked from a generic pack, not authored
    // for this game). A replacement mesh (e.g. from meshy.ai) will very
    // likely need these re-picked by hand: animations are read by INDEX,
    // not name (GltfAssetLabel::Animation(index) — Bevy never looks at a
    // clip's own name field), so open the new glb, note which index is
    // actually idle/walk/etc., and update the numbers below.
    animations: (
        idle: 5,
        walk: 22,
        run: 16,
        // Played instead of `run` while moving backward (LocalPlayerMoveAxis.y
        // < 0) — see CharacterAnimIndices' own doc comment (lib.rs). soldier.glb
        // also ships Run_Left (18) / Run_Right (19), currently unused.
        run_back: 17,
        shoot: 1,
        death: 0,
    ),

    // No character-specific audio yet (footsteps, voice lines) — add
    // files under characters/soldier/audio/ and list them here once they
    // exist.
    audio: [],
)
